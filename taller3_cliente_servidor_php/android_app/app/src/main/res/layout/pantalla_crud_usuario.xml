<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".vistas.PantallaCrudUsuario">

    <!-- Título dinámico: Registrar Usuario o Modificar Usuario -->
    <TextView
        android:id="@+id/txtTituloCrud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="25dp"
        android:gravity="center"
        android:text="DATOS DEL USUARIO"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="#3F51B5"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Campo Correo Electrónico (Antes llamado Codigo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtEtiquetaEmail"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="Correo:"
            android:textColor="#3F51B5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoCodigo2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress" />
    </LinearLayout>

    <!-- Campo Contraseña -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="Contraseña:"
            android:textColor="#3F51B5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoPassword2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ingrese su contraseña"
            android:inputType="textPassword" />
    </LinearLayout>

    <!-- Campo Nombre Completo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/etiquetaNombre"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="Nombre:"
            android:textColor="#3F51B5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nombre completo"
            android:inputType="textPersonName" />
    </LinearLayout>

    <!-- Botones de Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botonModificar"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="Guardar"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botonCancelar2"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="Cancelar"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
