<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TallerAndroid" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/ios_background</item>
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.TallerAndroid" parent="Base.Theme.TallerAndroid" />

    <style name="IosCard">
        <item name="android:background">@drawable/bg_ios_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="IosButton">
        <item name="android:background">@drawable/bg_ios_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>